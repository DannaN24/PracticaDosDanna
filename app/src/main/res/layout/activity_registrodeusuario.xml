<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/white"
    tools:context=".registrodeusuario">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white">

        <ImageView
            android:id="@+id/imgLogoUser"
            android:layout_width="124dp"
            android:layout_height="89dp"
            android:layout_marginTop="32dp"
            android:contentDescription="Icono de usuario"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/userpicturo" />

        <TextView
            android:id="@+id/textView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="serif"
            android:text="Registro de Usuarios"
            android:textColor="#306F39"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/imgLogoUser" />

        <!-- NOMBRES -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilNombres"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:hint="Nombres"
            app:boxBackgroundMode="outline"
            app:startIconDrawable="@drawable/person"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/txtNombres"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- APELLIDOS -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilApellido"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Apellidos"
            app:boxBackgroundMode="outline"
            app:startIconDrawable="@drawable/person"
            app:layout_constraintEnd_toEndOf="@+id/tilNombres"
            app:layout_constraintStart_toStartOf="@+id/tilNombres"
            app:layout_constraintTop_toBottomOf="@+id/tilNombres">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/txtApellido"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- TIPO DE DOCUMENTO -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilTipoDoc"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Tipo Doc"
            app:boxBackgroundMode="outline"
            app:startIconDrawable="@drawable/cedula"
            app:layout_constraintEnd_toEndOf="@+id/tilApellido"
            app:layout_constraintStart_toStartOf="@+id/tilApellido"
            app:layout_constraintTop_toBottomOf="@+id/tilApellido">

            <AutoCompleteTextView
                android:id="@+id/autoTipoDoc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                app:simpleItems="@array/tipo_doc" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- NÚMERO DE IDENTIFICACIÓN -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilCedula"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Número ID"
            app:boxBackgroundMode="outline"
            app:startIconDrawable="@drawable/cedula"
            app:layout_constraintEnd_toEndOf="@+id/tilTipoDoc"
            app:layout_constraintStart_toStartOf="@+id/tilTipoDoc"
            app:layout_constraintTop_toBottomOf="@+id/tilTipoDoc">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/txtCedula"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLength="10" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- ICONO DE GÉNERO -->
        <ImageView
            android:id="@+id/imageView2"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginTop="16dp"
            android:contentDescription="Icono de género"
            app:layout_constraintStart_toStartOf="@+id/tilCedula"
            app:layout_constraintTop_toBottomOf="@+id/tilCedula"
            app:srcCompat="@drawable/genero" />

        <!-- TÍTULO GÉNERO -->
        <TextView
            android:id="@+id/textView2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:fontFamily="serif"
            android:text="Género"
            android:textSize="17sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/imageView2"
            app:layout_constraintStart_toEndOf="@+id/imageView2"
            app:layout_constraintTop_toTopOf="@+id/imageView2" />

        <!-- OPCIONES DE GÉNERO -->
        <RadioGroup
            android:id="@+id/radioGroup"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="@+id/tilCedula"
            app:layout_constraintStart_toStartOf="@+id/tilCedula"
            app:layout_constraintTop_toBottomOf="@+id/imageView2">

            <RadioButton
                android:id="@+id/radioButton3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:drawableStart="@drawable/male"
                android:drawableTint="#3F51B5"
                android:text="Masculino" />

            <RadioButton
                android:id="@+id/radioButton2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:drawableStart="@drawable/woen"
                android:drawableTint="#8E24AA"
                android:text="Femenino" />

            <RadioButton
                android:id="@+id/radioButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Otro" />

        </RadioGroup>

        <!-- ICONO DE CALENDARIO -->
        <ImageView
            android:id="@+id/imageView3"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginTop="16dp"
            android:contentDescription="Icono de calendario"
            app:layout_constraintStart_toStartOf="@+id/tilCedula"
            app:layout_constraintTop_toBottomOf="@+id/radioGroup"
            app:srcCompat="@drawable/calendar" />

        <!-- TÍTULO FECHA DE NACIMIENTO -->
        <TextView
            android:id="@+id/textView3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:fontFamily="serif"
            android:text="Fecha Nacimiento"
            android:textSize="17sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/imageView3"
            app:layout_constraintStart_toEndOf="@+id/imageView3"
            app:layout_constraintTop_toTopOf="@+id/imageView3" />

        <!-- FECHA DE NACIMIENTO -->
        <LinearLayout
            android:id="@+id/llFechaNacimiento"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="@+id/tilCedula"
            app:layout_constraintStart_toStartOf="@+id/tilCedula"
            app:layout_constraintTop_toBottomOf="@+id/imageView3">

            <!-- DÍA -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Día"
                app:boxBackgroundMode="outline">

                <AutoCompleteTextView
                    android:id="@+id/autoDia"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    app:simpleItems="@array/dia" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- MES -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:hint="Mes"
                app:boxBackgroundMode="outline">

                <AutoCompleteTextView
                    android:id="@+id/autoMes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    app:simpleItems="@array/mes" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- AÑO -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:hint="Año"
                app:boxBackgroundMode="outline">

                <AutoCompleteTextView
                    android:id="@+id/autoAnio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    app:simpleItems="@array/anio" />

            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

        <!-- TELÉFONO -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilTelefono"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Teléfono"
            app:boxBackgroundMode="outline"
            app:startIconDrawable="@drawable/phone"
            app:layout_constraintEnd_toEndOf="@+id/llFechaNacimiento"
            app:layout_constraintStart_toStartOf="@+id/llFechaNacimiento"
            app:layout_constraintTop_toBottomOf="@+id/llFechaNacimiento">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/txtTelefono"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="phone" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- BOTÓN GRABAR -->
        <Button
            android:id="@+id/btnGrabar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="32dp"
            android:text="Grabar"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/tilTelefono"
            app:layout_constraintStart_toStartOf="@+id/tilTelefono"
            app:layout_constraintTop_toBottomOf="@+id/tilTelefono" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
